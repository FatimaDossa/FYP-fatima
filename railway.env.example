# Copy these into Railway → your service → Variables
# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Recommended for Railway (avoids downloading multi-GB GGUF models in the container)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_URDU=gpt-4o-mini
URDU_LLM_LOAD_VIA_HF=0
URDU_LLM_ENABLE=0

# Optional — Twilio OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
TWILIO_USE_WHATSAPP=false

# Optional — Firebase (paste full JSON as one line, or use a file mount)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — Hugging Face (faster embedding model download on cold start)
HF_TOKEN=

# Optional tuning
TICKET_CONFIDENCE_THRESHOLD=0.70
AUTO_RESOLVE_MINUTES=15
ALKHIDMAT_ZIP_PATH=Al Khidmat Knowledge Base.zip
